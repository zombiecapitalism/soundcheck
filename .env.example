SETLIST_FM_API_KEY=...
# RAG(곡 배경 설명)용 — 임베딩(text-embedding-3-small) + 생성 모두 OpenAI 하나로
OPENAI_API_KEY=...
# (선택) Wikipedia User-Agent에 붙일 연락처(이메일/URL) — Wikimedia 정책 권고
# RAG_CONTACT=mailto:you@example.com
# (선택) 재생목록(묶음 듣기)용 YouTube Data API v3 키 — 없으면 해당 기능만 비활성(503)
# YOUTUBE_API_KEY=...
# (선택) LLM 모델·대시보드 단가 오버라이드 — 기본값: gpt-4o-mini / 0.15 / 0.60 / 0.02 (USD/1M 토큰)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# LLM_COST_INPUT=0.15
# LLM_COST_OUTPUT=0.60
# LLM_COST_EMBEDDING=0.02
# (선택·운영) docker-compose.prod.yml의 웹 포트 — 기본 80
# WEB_PORT=80

DB_HOST=localhost
DB_PORT=5432
DB_NAME=encore
DB_USERNAME=...
DB_PASSWORD=...
ADMIN_USERNAME=admin
ADMIN_PASSWORD=...
